# ==============================================================================
# FUJI SMART DX – Environment Configuration
# Fuji Kyuko Co., Ltd. – Enterprise DX Platform
# ==============================================================================

# Application
APP_NAME="FUJI SMART DX"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuji_smart_dx

# Security & Authentication
SECRET_KEY=fuji_kyuko_dx_secret_key_production_grade_change_in_real_deployment_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Superuser / Demo accounts
INITIAL_ADMIN_EMAIL=admin@fujikyu.co.jp
INITIAL_ADMIN_PASSWORD=FujiSmartAdmin2026!
INITIAL_ANALYST_EMAIL=analyst@fujikyu.co.jp
INITIAL_ANALYST_PASSWORD=FujiSmartAnalyst2026!

# External API Integrations
# 1. Japan Meteorological Agency (JMA) - Public JSON APIs (No Key Required)
JMA_BASE_URL=https://www.jma.go.jp/bosai/forecast/data/forecast
JMA_YAMANASHI_CODE=190000

# 2. Japan e-Stat API (Statistics Bureau of Japan)
# Obtain free application ID at: https://www.e-stat.go.jp/api/
ESTAT_APP_ID=

# 3. JNTO (Japan National Tourism Organization)
# Obtain developer credential from JNTO open data portal: https://www.jnto.go.jp/
JNTO_API_KEY=

# 4. MLIT (Ministry of Land, Infrastructure, Transport and Tourism)
# Open data portal: https://www.mlit.go.jp/
MLIT_API_KEY=

# 5. OpenStreetMap & Routing
OPENSTREETMAP_NOMINATIM_URL=https://nominatim.openstreetmap.org
OPENSTREETMAP_ROUTING_URL=https://router.project-osrm.org

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
